<script type="text/javascript" id="bridge-default-js-after">
/* <![CDATA[ */
document.addEventListener('DOMContentLoaded', function () {
  const TARGET_URL = 'https://www.lortodieleonora.com/';
  const SIDE_ZONE_PX = 250;          // larghezza colonne laterali
  const TOP_OFFSET_PX = 250;         // distanza dal top della pagina
  const MAX_HEIGHT_PX = 1000;        // altezza massima cliccabile
  const WINDOW_TOP = TOP_OFFSET_PX;
  const WINDOW_BOTTOM = TOP_OFFSET_PX + MAX_HEIGHT_PX;

  const mq = window.matchMedia('(min-width: 1001px)');
  const containers = document.querySelectorAll('.content .container, .full_width');

  function isInteractive(target){
    return !!target.closest('a, button, input, textarea, select, [role="button"]');
  }

  function isSelectingText(){
    return (window.getSelection && window.getSelection().toString().trim().length > 0);
  }

  // Verifica: dentro alle due colonne laterali E dentro alla finestra verticale (rispetto alla pagina)
  function inSideZones(event, el){
    const rect = el.getBoundingClientRect();
    const x = event.clientX - rect.left;             // x relativo al container
    const usableWidth = rect.width >= (SIDE_ZONE_PX * 2);
    if (!usableWidth) return false;

    const insideLeftOrRight = (x <= SIDE_ZONE_PX) || (x >= rect.width - SIDE_ZONE_PX);
    if (!insideLeftOrRight) return false;

    // y della pagina (non della viewport)
    const pageY = window.scrollY + event.clientY;

    // finestra verticale globale (dalla pagina)
    const inVerticalWindow = (pageY >= WINDOW_TOP) && (pageY <= WINDOW_BOTTOM);
    if (!inVerticalWindow) return false;

    // inoltre, richiedi che il puntatore sia anche verticalmente dentro il container
    const yRelToEl = event.clientY - rect.top;
    const insideElVertically = (yRelToEl >= 0) && (yRelToEl <= rect.height);
    if (!insideElVertically) return false;

    return true;
  }

  function enable(el){
    if (el.__bgClickEnabled) return;

    el.__bgClickHandler = function(e){
      if (!mq.matches) return;
      if (isInteractive(e.target)) return;
      if (isSelectingText()) return;
      if (!inSideZones(e, el)) return;

      if (e.metaKey || e.ctrlKey || e.button === 1) {
        window.open(TARGET_URL, '_blank');
      } else {
        window.location.href = TARGET_URL;
      }
    };

    // Feedback cursore solo quando si è effettivamente "dentro" alle zone valide
    el.__bgMoveHandler = function(e){
      if (!mq.matches) { el.classList.remove('bg-side-zone'); return; }
      if (inSideZones(e, el)) el.classList.add('bg-side-zone');
      else el.classList.remove('bg-side-zone');
    };

    el.__bgLeaveHandler = function(){
      el.classList.remove('bg-side-zone');
    };

    el.addEventListener('click', el.__bgClickHandler);
    el.addEventListener('mousemove', el.__bgMoveHandler);
    el.addEventListener('mouseleave', el.__bgLeaveHandler);
    el.__bgClickEnabled = true;
  }

  function disable(el){
    if (!el.__bgClickEnabled) return;
    el.removeEventListener('click', el.__bgClickHandler);
    el.removeEventListener('mousemove', el.__bgMoveHandler);
    el.removeEventListener('mouseleave', el.__bgLeaveHandler);
    el.classList.remove('bg-side-zone');
    el.__bgClickEnabled = false;
  }

  function applyState(){
    containers.forEach(el => mq.matches ? enable(el) : disable(el));
  }

  (mq.addEventListener ? mq.addEventListener('change', applyState) : mq.addListener(applyState));
  applyState();
});
//# sourceURL=bridge-default-js-after
/* ]]> */
</script>
